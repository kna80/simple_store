<style>
  body {
    font-family: Arial, sans-serif;
    background-color: #f4f6f8;
    margin: 0;
    padding: 20px;
  }

  h1 {
    text-align: center;
    color: #333;
  }

  .search-container {
    text-align: center;
    margin: 25px 0;
  }

  .search-input {
    padding: 12px;
    width: 300px;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 16px;
  }

  .search-button {
    padding: 12px 20px;
    background-color: #28a745;
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 16px;
  }

  .search-button:hover {
    background-color: #218838;
  }

  .product-count {
    text-align: center;
    font-size: 18px;
    margin-bottom: 30px;
  }

  .products-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  .product-card {
    background: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  .product-card h2 {
    font-size: 20px;
    color: #222;
  }

  .price {
    color: #28a745;
    font-size: 20px;
    font-weight: bold;
  }

  .stock {
    color: #666;
  }
</style>

<h1>🛍️ Welcome to Simple Store</h1>

<div class="search-container">
  <%= form_with url: "/products", method: :get, local: true do |form| %>

    <%= form.text_field :search,
        placeholder: "Search products...",
        value: params[:search],
        class: "search-input" %>

    <%= form.submit "Search", class: "search-button" %>

  <% end %>
</div>

<p class="product-count">
  Total Products: <%= @products.count %>
</p>

<div class="products-container">

  <% @products.each do |product| %>

    <div class="product-card">

      <h2><%= link_to product.title, product_path(product) %></h2>

      <p class="price">
        $<%= number_with_precision(product.price, precision: 2) %>
      </p>

      <p class="stock">
        Stock Available: <%= product.stock_quantity %>
      </p>
      
<p class="category">
  Category: <%= product.category.name %>
</p>
    </div>

  <% end %>

</div>